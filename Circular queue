#include <stdbool.h>
#include <stdlib.h>

typedef struct {
    int* data;    
    int head;     
    int size;     
    int capacity; 
} MyCircularQueue;

// 1. Create function
MyCircularQueue* myCircularQueueCreate(int k) {
    if (k <= 0) return NULL; 

    MyCircularQueue* obj = (MyCircularQueue*)malloc(sizeof(MyCircularQueue));
    if (obj != NULL) {
        obj->data = (int*)malloc(k * sizeof(int));
        obj->head = 0;
        obj->size = 0;
        obj->capacity = k;
    }
    return obj;
}

// 2. IsEmpty function 
bool myCircularQueueIsEmpty(MyCircularQueue* obj) {
    if (obj == NULL || obj->capacity <= 0) return true;
    return obj->size == 0;
}

// 3. IsFull function
bool myCircularQueueIsFull(MyCircularQueue* obj) {
    if (obj == NULL || obj->capacity <= 0) return false;
    return obj->size == obj->capacity;
}

// 4. EnQueue function 
bool myCircularQueueEnQueue(MyCircularQueue* obj, int value) {
    if (obj == NULL || obj->capacity <= 0 || myCircularQueueIsFull(obj)) {
        return false;
    }
    int tail = (obj->head + obj->size) % obj->capacity;
    obj->data[tail] = value;
    obj->size++;
    return true;
}

// 5. DeQueue function 
bool myCircularQueueDeQueue(MyCircularQueue* obj) {
    if (obj == NULL || obj->capacity <= 0 || myCircularQueueIsEmpty(obj)) {
        return false;
    }
    obj->head = (obj->head + 1) % obj->capacity;
    obj->size--;
    return true;
}

// 6. Front function (FIXED: Returns -1 safely when empty)
int myCircularQueueFront(MyCircularQueue* obj) {
    if (obj == NULL || myCircularQueueIsEmpty(obj)) {
        return -1;
    }
    return obj->data[obj->head];
}

// 7. Rear function (FIXED: Handles circular wrapping without negative indices)
int myCircularQueueRear(MyCircularQueue* obj) {
    if (obj == NULL || myCircularQueueIsEmpty(obj)) {
        return -1;
    }
    int tail = (obj->head + obj->size - 1 + obj->capacity) % obj->capacity;
    return obj->data[tail];
}

// 8. Free function
void myCircularQueueFree(MyCircularQueue* obj) {
    if (obj != NULL) {
        if (obj->data != NULL) {
            free(obj->data); 
        }
        free(obj); 
    }
}
